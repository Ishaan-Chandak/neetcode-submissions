#include <iostream>
#include <bits/stdc++.h>
using namespace std;

#define int long long

const long long llmod = 1e9 + 7;

void dfs(int node, vector<int>& vis, vector<vector<int>>& adj, stack<int>& st) {
	vis[node] = 1;

	for (auto it : adj[node]) {
		if (vis[it] == 0)
			dfs(it, vis, adj, st);
	}

	st.push(node);
}

void dfs2(int node, vector<int>& vis, vector<vector<int>>& adj, vector<int>& cmp) {
	vis[node] = 1;
	cmp.push_back(node);

	for (auto it : adj[node]) {
		if (vis[it] == 0)
			dfs2(it, vis, adj, cmp);
	}
}

void dfs3(int node, int parent, vector<int>& vis, vector<vector<int>>& adj, set<pair<int, int>>& s, vector<int>& nodeComponents) {
	vis[node] = 1;
	if(parent != -1) s.insert({nodeComponents[parent], nodeComponents[node]});
	
// 	cout << parent << " " << node << endl;

	for (auto it : adj[node]) {
		if (vis[it] == 0) {
			dfs3(it, node, vis, adj, s, nodeComponents);
		}
		else {
			if(parent != -1) s.insert({nodeComponents[node], nodeComponents[it]});
		}
	}
}

int dfs4(int node,
         vector<vector<int>>& adj,
         unordered_map<int,int>& mp,
         vector<int>& dp)
{
    if(dp[node] != -1)
        return dp[node];

    int best = 0;

    for(auto nxt : adj[node])
        best = max(best, dfs4(nxt, adj, mp, dp));

    return dp[node] = mp[node] + best;
}

signed main() {
	int n, m;
	cin >> n >> m;

	vector<int> cost(n + 1, 0);

	for (int i = 1; i <= n; i++)
		cin >> cost[i];

	vector<vector<int>> edges;

	for (int i = 0; i < m; i++) {
		int u, v;
		cin >> u >> v;
		edges.push_back({u, v});
	}

	vector<vector<int>> adj(n + 1);

	for (auto edge : edges)
		adj[edge[0]].push_back(edge[1]);

	stack<int> st;
	vector<int> vis(n + 1, 0);

	for (int i = 1; i <= n; i++) {
		if (!vis[i])
			dfs(i, vis, adj, st);
	}

	vector<vector<int>> rev(n + 1);

	for (auto edge : edges)
		rev[edge[1]].push_back(edge[0]);

	vector<int> vis2(n + 1, 0);
	int cnt = 0;
	vector<vector<int>> cmp;

	while (!st.empty()) {
		int node = st.top();
		st.pop();

		vector<int> cmpParts;

		if (!vis2[node]) {
			cnt++;
			dfs2(node, vis2, rev, cmpParts);
		}

		if (!cmpParts.empty())
			cmp.push_back(cmpParts);
	}

	vector<int> nodeComponents(n+1, 0);
	unordered_map<int, int> mp;
	
	int cnt2 = 1;
	for(auto it: cmp) {
		int currSum = 0;
		for(auto v: it) {
		  //  cout << v << " ";
			nodeComponents[v] = cnt2;
			currSum += cost[v];
		}
// 		cout << endl;
		mp[cnt2] = currSum;
// 		cout << currSum << " ";
		cnt2++;
	}
	
// 	cout << endl;

	set<pair<int,int>> s;

    for(auto edge:edges)
    {
        int u=nodeComponents[edge[0]];
        int v=nodeComponents[edge[1]];
    
        if(u!=v)
            s.insert({u,v});
    }
    
    int cmpn = cmp.size();
    
    vector<vector<int>> adjCmp(cmpn+1);
    
    for(auto e:s)
        adjCmp[e.first].push_back(e.second);


	for(auto it: s) {
	    if(it.first == it.second) continue;
		adjCmp[it.first].push_back(it.second);
// 		cout << it.first << " " << it.second << endl;
	}
	
	vector<int> dp(cmpn+1,-1);

    int maxi=0;
    
    for(int i=1;i<=cmpn;i++)
        maxi=max(maxi,dfs4(i,adjCmp,mp,dp));
    
    cout << maxi << endl;


	return 0;
}
