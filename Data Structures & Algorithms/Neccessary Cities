#include <iostream>
#include<bits/stdc++.h>
using namespace std;

int timer = 0;

void dfs(int node, int parent, vector<int>& vis, vector<vector<int>>& adj, vector<int>& tin, vector<int>& low, vector<int>& ans) {
	vis[node] = 1;
    tin[node] = low[node] = timer;
    timer++;
    int child = 0;
	for(auto it: adj[node]) {
	    if(parent == it) continue;
		if(vis[it] == 0) {
		    dfs(it, node, vis, adj, tin, low, ans);
		    low[node] = min(low[node], low[it]);
		    child++;
		    if(tin[node] <= low[it] && parent != -1) ans[node] = 1;
		} else {
		    low[node] = min(low[node], tin[it]);
		}
	}
	
	if(parent == -1 && child > 1) ans[node] = 1;
}

int main()
{
	int n, m;
	cin >> n >> m;
	vector<vector<int>> edges;
	for(int i=0; i<m; i++) {
		int temp, tem1;
		cin >> temp >> tem1;
		edges.push_back({temp, tem1});
	}

	vector<vector<int>> adj(n + 1);

	for(auto edge : edges){
	    adj[edge[0]].push_back(edge[1]);
	    adj[edge[1]].push_back(edge[0]);
	}
	
	vector<int> vis(n + 1, 0);
    vector<int> tin(n + 1), low(n + 1);
    vector<int> ans(n+1, 0);

    for(int i=1; i<=n; i++) {
        if(vis[i] == 0) dfs(i, -1, vis, adj, tin, low, ans);
    }
    
    vector<int> ret;
    for(int i=1; i<=n; i++) {
        if(ans[i] == 1) ret.push_back(i);
    }
    
    cout << ret.size() << endl;
    for(auto it: ret) {
        cout << it << " ";
    }
    cout << endl;


	return 0;
}
