#include <iostream>
#include<bits/stdc++.h>
using namespace std;

int timer = 0;

void dfs(int node, int parent, vector<int>& vis, vector<vector<int>>& adj, vector<int>& tin, vector<int>& low, vector<vector<int>>& bridges) {
	vis[node] = 1;
    tin[node] = low[node] = timer;
    timer++;
	for(auto it: adj[node]) {
		if(vis[it] == 0) {
		    dfs(it, node, vis, adj, tin, low, bridges);
		    low[node] = min(low[node], low[it]);
		    
		    if(tin[node] < low[it]) bridges.push_back({node, it});
		} else if (it != parent){
		    low[node] = min(low[node], low[it]);
		}
	}
}

int main()
{
	int n, m;
	cin >> n >> m;
	vector<vector<int>> edges;
	for(int i=0; i<m; i++) {
		int temp, tem1;
		cin >> temp >> tem1;
		edges.push_back({temp, tem1});
	}

	vector<vector<int>> adj(n + 1);

	for(auto edge : edges){
	    adj[edge[0]].push_back(edge[1]);
	    adj[edge[1]].push_back(edge[0]);
	}
	
	vector<int> vis(n + 1, 0);
    vector<int> tin(n + 1), low(n + 1);
    vector<vector<int>> ans;

    for(int i=1; i<=n; i++) {
        if(vis[i] == 0) dfs(i, -1, vis, adj, tin, low, ans);
    }
    
    cout << ans.size() << endl;
    for(auto it: ans) {
        cout << it[0] << " " << it[1] << endl;
    }


	return 0;
}
