#include <iostream>
#include <bits/stdc++.h>
using namespace std;
 
#define int long long
 
const long long llmod = 1e9 + 7;
 
void dfs(int node, vector<int>& vis, vector<vector<int>>& adj, stack<int>& st) {
    vis[node] = 1;
 
    for (auto it : adj[node]) {
        if (vis[it] == 0)
            dfs(it, vis, adj, st);
    }
 
    st.push(node);
}
 
void dfs2(int node, vector<int>& vis, vector<vector<int>>& adj, vector<int>& cmp) {
    vis[node] = 1;
    cmp.push_back(node);
 
    for (auto it : adj[node]) {
        if (vis[it] == 0)
            dfs2(it, vis, adj, cmp);
    }
}
 
signed main() {
    int n;
    cin >> n;
 
    vector<int> cost(n + 1, 0);
 
    for (int i = 1; i <= n; i++)
        cin >> cost[i];
 
    int m;
    cin >> m;
 
    vector<vector<int>> edges;
 
    for (int i = 0; i < m; i++) {
        int u, v;
        cin >> u >> v;
        edges.push_back({u, v});
    }
 
    vector<vector<int>> adj(n + 1);
 
    for (auto edge : edges)
        adj[edge[0]].push_back(edge[1]);
 
    stack<int> st;
    vector<int> vis(n + 1, 0);
 
    for (int i = 1; i <= n; i++) {
        if (!vis[i])
            dfs(i, vis, adj, st);
    }
 
    vector<vector<int>> rev(n + 1);
 
    for (auto edge : edges)
        rev[edge[1]].push_back(edge[0]);
 
    vector<int> vis2(n + 1, 0);
    int cnt = 0;
    vector<vector<int>> cmp;
 
    while (!st.empty()) {
        int node = st.top();
        st.pop();
 
        vector<int> cmpParts;
 
        if (!vis2[node]) {
            cnt++;
            dfs2(node, vis2, rev, cmpParts);
        }
 
        if (!cmpParts.empty())
            cmp.push_back(cmpParts);
    }
 
   for(auto& it: cmp) {
       for(auto& v: it) {
           v = cost[v];
       }
   }
   
   long long total = 1, pathCost = 0;
   for(auto it: cmp) {
       long long mini = LLONG_MAX; 
       for(auto v: it) {
           mini = min(mini, v);
       }
       pathCost += mini;
       int cnt2 = 0;
       for(auto& v: it) {
           if(v == mini) cnt2++;
       }
       
       total = (total * cnt2) % llmod;
   }
   
   cout << pathCost << " " << total;
 
    return 0;
}
